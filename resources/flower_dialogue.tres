[resource]
script = Resource("res://resources/dialogue_line.gd")
lines = Array[String](["[Lobby] The flowers here have witnessed many visitors...", "[Lobby] Each petal tells a story of those who passed through.", "[Lobby] The grasslands hold secrets beyond this lobby.", "[Lobby] Venture deeper, traveler. Time waits for no one."])
