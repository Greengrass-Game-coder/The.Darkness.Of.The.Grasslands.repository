[resource]
script = Resource("res://resources/dialogue_line.gd")
lines = Array[String](["[Browngrass] ...", "[Browngrass] It's all your fault...", "[Browngrass] You did this to yourself.", "[Lobby Person] (Choose)", "[Browngrass] I wont tell you...", "[Browngrass] Your doing... Your. Problem.", "[Browngrass] Anyways-- Welcome to the Grasslands... Err.. What's left of it now...", "[Browngrass] Anything you wanna say now..?", "[Lobby Person] (Choose)", "[Browngrass] This flower...?", "[Browngrass] Love and Tragedy...", "[Browngrass] I am nobody...", "[Browngrass] if you will ask me that same specific question i am gonna lose it.", "[Browngrass] ...", "[Browngrass] There is no way out... You got here by accident.", "[Browngrass] ...", "[Browngrass] Me and my best friend...", "[Browngrass] Good.. Now cease.", "[Browngrass] Oh Great...", "[Browngrass] It's not okay... Its just... NOT... okay... Please... Leave me alone."])
